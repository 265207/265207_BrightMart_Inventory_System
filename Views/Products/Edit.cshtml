@model BrightMartInventorySystem.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">
    <h1>Edit Product</h1>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="ProductId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label">
                Product Name
            </label>
            <input asp-for="ProductName" class="form-control" />
            <span asp-validation-for="ProductName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SupplierId" class="form-label">
                Supplier
            </label>
            <select asp-for="SupplierId"
                    asp-items="ViewBag.SupplierId"
                    class="form-select"></select>
            <span asp-validation-for="SupplierId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnitPrice" class="form-label">
                Unit Price
            </label>
            <input asp-for="UnitPrice" class="form-control"
                   type="number" step="0.01" />
            <span asp-validation-for="UnitPrice"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="QuantityInStock" class="form-label">
                Quantity in Stock
            </label>
            <input asp-for="QuantityInStock"
                   class="form-control" type="number" />
            <span asp-validation-for="QuantityInStock"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ReorderLevel" class="form-label">
                Reorder Level
            </label>
            <input asp-for="ReorderLevel"
                   class="form-control" type="number" />
            <span asp-validation-for="ReorderLevel"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
