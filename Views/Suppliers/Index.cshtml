@model IEnumerable<BrightMartInventorySystem.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="container mt-4">
    <h1>Supplier Management</h1>
    <p>Manage BrightMart Traders suppliers.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    @if (User.IsInRole("Admin"))
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">
                Add Supplier
            </a>
        </p>
    }

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control"
                   placeholder="Search supplier or contact person" />
            <button class="btn btn-secondary" type="submit">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Supplier</th>
                <th>Contact Person</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.SupplierId</td>
                    <td>@supplier.SupplierName</td>
                    <td>@supplier.ContactPerson</td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.Email</td>
                    
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@supplier.SupplierId"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@supplier.SupplierId"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@supplier.SupplierId"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p>No suppliers have been added yet.</p>
    }
</div>
