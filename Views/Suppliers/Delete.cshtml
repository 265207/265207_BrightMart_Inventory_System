@model BrightMartInventorySystem.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container mt-4">
    <h1>Delete Supplier</h1>

    <div class="alert alert-warning">
        Are you sure you want to delete this supplier?
        Suppliers linked to products cannot be deleted.
    </div>

    <p><strong>Supplier:</strong> @Model.SupplierName</p>
    <p><strong>Contact:</strong> @Model.ContactPerson</p>
    <p><strong>Email:</strong> @Model.Email</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="SupplierId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
